rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isMasterTeacher() {
      return (isAuthenticated() && request.auth.token.email == "spacio.n.blnco@gmail.com" && request.auth.token.email_verified == true);
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['id', 'email', 'fullName', 'role', 'createdAt', 'lastActiveAt']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 256 &&
             data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 160 &&
             data.role in ['student', 'teacher'] &&
             // Students can register freely; Teachers require Master Teacher authorization (spacio.n.blnco@gmail.com)
             (data.role == 'student' || data.email == 'spacio.n.blnco@gmail.com' || data.authorizedTeacherByMaster == true) &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             data.lastActiveAt is string && data.lastActiveAt.size() <= 64;
    }

    function isValidStudentProgress(data) {
      return data.keys().hasAll(['userId', 'completedLessons', 'masteredWords', 'xp', 'streakDays', 'unlockedBadges', 'updatedAt']) &&
             data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.completedLessons is list && data.completedLessons.size() <= 500 &&
             data.masteredWords is list && data.masteredWords.size() <= 2000 &&
             data.xp is number && data.xp >= 0 &&
             data.streakDays is number && data.streakDays >= 0 &&
             data.unlockedBadges is list && data.unlockedBadges.size() <= 100 &&
             data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    // Connection health check endpoint
    match /test/{docId} {
      allow read: if true;
    }

    // User Profiles collection (/users/{userId})
    // Students can register freely; Teachers require authorization from spacio.n.blnco@gmail.com
    match /users/{userId} {
      allow read: if true;
      allow create: if isValidUserProfile(request.resource.data);
      allow update: if isValidUserProfile(request.resource.data);
      allow delete: if true;
    }

    // Student Academic Progress collection (/student_progress/{userId})
    match /student_progress/{userId} {
      allow read: if true;
      allow create, update: if isValidStudentProgress(request.resource.data);
      allow delete: if true;
    }
  }
}
